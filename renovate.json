{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Self-hosted via .github/workflows/renovate.yaml as a GitHub App, so platformCommit can produce the signed commits the main ruleset requires."
  ],
  "extends": ["config:recommended", ":semanticCommitsDisabled"],
  "labels": ["renovate"],
  "timezone": "Europe/Berlin",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 10,
  "platformCommit": "enabled",
  // supply chain cooldown: a compromised release is usually yanked within days;
  // vulnerability fixes skip it (vulnerabilityAlerts defaults to minimumReleaseAge null)
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  // GitHub alerts need Dependabot alerts enabled and read access for the app;
  // OSV works without either, but only covers direct dependencies
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "docker-compose": {
    "managerFilePatterns": ["/^dev/[^/]+\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update versions annotated with inline renovate comments",
      "managerFilePatterns": [
        "/\\.github/.+/[^/]+\\.ya?ml$/",
        "/^tools/ci-image/Dockerfile$/",
        "/^services/[^/]+/Dockerfile$/"
      ],
      "matchStrings": [
        // Match lines like:
        // # renovate: datasource=github-releases depName=EmbarkStudios/cargo-deny versioning=semver
        // CARGO_DENY_VERSION="0.19.4"
        // or like:
        // # renovate: datasource=github-releases depName=rust-lang/rust versioning=semver
        // toolchain: "1.93"
        // or like:
        // # renovate: datasource=github-releases depName=EmbarkStudios/cargo-deny versioning=semver
        // ARG CARGO_DENY_VERSION=0.19.4
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\n[^\\S\\n]*(?:ARG[^\\S\\n]+)?\\S+\\s*[=:]\\s*[\"']?v?(?<currentValue>[^\"'\\s]+)"
      ]
    },
    {
      "customType": "jsonata",
      "description": "Update the openapi-generator release gen-api runs, pinned in openapitools.json (JSON cannot carry a renovate comment); the gen-api drift check fails the PR until the clients are regenerated",
      "fileFormat": "json",
      "managerFilePatterns": ["/^openapitools\\.json$/"],
      "matchStrings": ["{ \"currentValue\": `generator-cli`.version }"],
      "datasourceTemplate": "maven",
      "depNameTemplate": "org.openapitools:openapi-generator-cli"
    }
  ],
  // GitHub merges each PR once the required ci-gate check passes, independent of Renovate's
  // runs, which stop after two automerges each
  "platformAutomerge": true,
  "automergeType": "pr",
  // GitHub signs squash commits (main requires signatures); branches need not be up to date
  "automergeStrategy": "squash",
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "description": "Automerge Rust patch updates of all crates; Cargo.lock changes run the full workspace CI",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Automerge Rust minor updates of stable crates",
      "matchManagers": ["cargo"],
      "matchPackageNames": [
        "serde",
        "serde_json",
        "tokio",
        "anyhow",
        "thiserror",
        "tracing",
        "tracing-subscriber",
        "clap",
        "uuid",
        "base64",
        "bytes",
        "url",
        "futures",
        "futures-util",
        "secrecy",
        "time",
        "time-tz",
        "tower-http"
      ],
      "matchUpdateTypes": ["minor"],
      "automerge": true
    },
    {
      "description": "Automerge Rust build-only dependencies",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["prost-build", "tonic-prost-build"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    },
    {
      "description": "Automerge all frontend devDependencies",
      "matchManagers": ["npm"],
      // https://docs.renovatebot.com/modules/manager/npm/#dependency-types
      // catalog dependencies produce dynamic depType values: pnpm.catalog.<name>
      "matchDepTypes": ["devDependencies", "pnpm.catalog.devDependencies"],
      "automerge": true
    },
    {
      "description": "Automerge frontend utility dependencies (patch)",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "clsx",
        "react-toastify",
        "react-i18next",
        "i18next-browser-languagedetector",
        "i18next-http-backend",
        "qrcode.react"
      ],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Automerge Dockerfile base images (patch, minor and digest)",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["patch", "minor", "digest"],
      "automerge": true
    },
    {
      "description": "Automerge GitHub Actions (patch and digest)",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true
    },
    {
      "description": "Only update the lock file of the Python service, keep its ranges",
      "matchManagers": ["pep621"],
      "rangeStrategy": "update-lockfile"
    },
    {
      "description": "Group tonic packages",
      "groupName": "tonic monorepo",
      "matchManagers": ["cargo"],
      "matchSourceUrls": ["https://github.com/hyperium/tonic"],
      "matchUpdateTypes": ["digest", "patch", "minor", "major"]
    },
    {
      "description": "Group storybook packages",
      "groupName": "storybook monorepo",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies", "pnpm.catalog.devDependencies"],
      "matchSourceUrls": ["https://github.com/storybookjs/storybook"],
      "matchUpdateTypes": ["digest", "patch", "minor", "major"]
    },
    {
      "description": "Group vitest packages",
      "groupName": "vitest monorepo",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies", "pnpm.catalog.devDependencies"],
      "matchSourceUrls": ["https://github.com/vitest-dev/vitest"],
      "matchUpdateTypes": ["digest", "patch", "minor", "major"]
    },
    {
      "description": "Group tsparticles packages",
      "groupName": "tsparticles monorepo",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies", "pnpm.catalog.dependencies"],
      "matchSourceUrls": ["https://github.com/tsparticles/tsparticles"],
      "matchUpdateTypes": ["digest", "patch", "minor", "major"]
    },
    {
      "description": "Group eslint packages",
      "groupName": "eslint packages",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies", "pnpm.catalog.devDependencies"],
      "matchPackageNames": ["/eslint/"],
      "matchUpdateTypes": ["digest", "patch", "minor", "major"]
    },
    {
      "description": "Group i18next packages",
      "groupName": "i18next packages",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies", "pnpm.catalog.dependencies"],
      "matchPackageNames": ["/i18next/"],
      "matchUpdateTypes": ["digest", "patch", "minor", "major"]
    },
    {
      "description": "Move the Rust toolchain of CI and every Dockerfile in one PR, never automerged since new clippy lints break -D warnings",
      "groupName": "rust toolchain",
      "matchPackageNames": ["rust"],
      "matchDatasources": ["docker", "rust-version"],
      "automerge": false
    },
    {
      "description": "neo4j uses calendar versions with an edition suffix and holds the production graph, never automerged",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["neo4j"],
      "versioning": "regex:^(?<major>\\d{4})\\.(?<minor>\\d{2})(\\.(?<patch>\\d+))?-(?<compatibility>community)$",
      "automerge": false
    },
    {
      "description": "The mtg scanner assets are built and pinned by hand (just mtg-assets), the package is private to Renovate",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/myomikron/mtg/assets"],
      "enabled": false
    }
  ]
}
