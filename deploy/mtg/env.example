# Copy to `.env` next to compose.yml and fill in — compose reads it
# automatically. Everything marked (required) makes `docker compose` fail
# with a clear error when missing.

# Public host the app is served from. WebAuthn binds passkeys to this host
# (rp_id) — changing it invalidates every registered passkey! (required)
DOMAIN=mtg.example.com

# Image tags to deploy, published by pushing the git tags mtg/vX.Y.Z and
# mail-gateway/vX.Y.Z. Pin explicit versions; `latest` makes rollbacks and
# "what is running right now?" guesswork. (required)
MTG_VERSION=v0.1.0
MAIL_GATEWAY_VERSION=v0.1.0

# (required)
POSTGRES_PASSWORD=

# Neo4j password for the graph advisor's database. (required)
NEO4J_PASSWORD=

# Scryfall rejects requests with a generic HTTP-library User-Agent (400
# generic_user_agent). Identify the deployment with real contact info, e.g.
# "Planarium/1.0 (+mailto:you@example.com)". (required)
SCRYFALL_USER_AGENT=

# The graph container loads its corpus (cards, tags, semantics, combos) on
# start, skipping whatever the graph already holds — an empty Neo4j volume
# therefore costs one slow boot instead of an advisor that reports 0 for every
# role. Set to false to serve immediately and load it by hand with
# `just prod mtg exec graph deck-lab bootstrap`. (optional, default true)
BOOTSTRAP_ON_START=

# SMTP relay the mail-gateway delivers through. SMTP_USER may stay empty for
# an unauthenticated relay; if set, SMTP_PASSWORD is required too.
# SMTP_SECURITY: starttls (default), implicit, or none. (SMTP_HOST, MAIL_FROM required)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=MTG <noreply@example.com>

# Observability — all optional. An empty OTLP endpoint disables trace export.
OTEL_EXPORTER_OTLP_ENDPOINT=
ALERTMANAGER_URL=http://localhost
GRAFANA_TRACING_URI=http://localhost
