# Shared environment for all dev stacks.

POSTGRES_DB=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# NATS from dev/infra.yml, reachable via the external `dev` network
NATS_URL=nats://nats:4222

# Required by service-bootstrap. Placeholders so services boot in dev —
# point these at a real Alertmanager/Grafana once one exists.
#
# Trace export is off in dev: an empty endpoint disables the exporter. With a
# placeholder url the batch exporter logged a failed connect on every flush.
# Set this to a real collector to turn it back on.
OTEL_EXPORTER_OTLP_ENDPOINT=
ALERTMANAGER_URL=http://localhost
GRAFANA_TRACING_URI=http://localhost

# Public origin the frontends are served from (WebAuthn rp_origin).
#
# The tailnet host, not localhost: it is the only one a phone can reach, and
# the scanner needs a real camera. Passkeys are bound to the host through
# `rp_id`, so exactly one origin can work at a time — switching this back to
# `http://localhost` makes the passkeys registered here unusable, and vice
# versa. Everything except signing in works on either.
#
# Spelled out rather than `https://${DOMAIN}`: compose interpolates an env_file
# only against its own environment, not against entries of the same file, so
# referencing DOMAIN here yields an empty host.
PUBLIC_ORIGIN=https://${COMPOSE_PROJECT_NAME}-dev-${USER}.int.omikron.dev

# --- Tailscale ---------------------------------------------------------------
# The dev stack joins the tailnet so a phone can reach it: the scanner needs a
# real camera, and WebAuthn needs a secure context, which http://<lan-ip> is
# not. Requires TS_AUTHKEY in `dev/common/env.secret`, see env.secret.example.

# The node name, and the host the stack answers on. Per developer and per
# stack, so two people starting the same one do not collide.
TS_HOSTNAME=${COMPOSE_PROJECT_NAME}-dev-${USER}
DOMAIN=${COMPOSE_PROJECT_NAME}-dev-${USER}.int.omikron.dev
# Self-hosted coordination server. Without this the node talks to
# controlplane.tailscale.com, which rejects the auth key as invalid.
TS_EXTRA_ARGS=--login-server=https://sdn.omikron.dev
# The tailnet resolver would take over DNS for the whole namespace, and traefik
# shares it — compose service names have to keep resolving through docker.
TS_ACCEPT_DNS=false
TS_STATE_DIR=/var/lib/tailscale
