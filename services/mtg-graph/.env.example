# Copy to .env and adjust. Everything here has a working default for local dev.

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=deck-lab-dev
NEO4J_DATABASE=neo4j

# Scryfall 400s requests with a default HTTP-library User-Agent. Put real
# contact info here before running anything at volume.
SCRYFALL_USER_AGENT=ScryDeckLab/0.1 (+https://github.com/local/scry-before-you-buy)

# --- serving -----------------------------------------------------------------
# All of these are per uvicorn worker. Defaults suit a single-node test site;
# see backend/README.md before raising them.

# Response caches. 0 disables caching; the TTL bounds how long a report
# computed before an EDHREC warm-up can still be served.
# RESPONSE_CACHE_MAX_ENTRIES=256
# RESPONSE_CACHE_TTL_SECONDS=300
# FACETS_CACHE_TTL_SECONDS=3600

# Concurrent /fill solves and threads per solve. Saturation returns 429.
# SOLVER_NUM_WORKERS=4
# FILL_MAX_CONCURRENT=3
# FILL_ACQUIRE_TIMEOUT_SECONDS=0

# Corpus scans at boot. Set false if the --reload restart cost grates in dev.
# WARMUP_ON_START=true

# Per-client token bucket. Best-effort; a fronting proxy is the real shield.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_RPS=2
# RATE_LIMIT_BURST=10
