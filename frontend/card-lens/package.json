{
  "name": "card-lens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "HTTPS=1 vite --host",
    "build": "tsc && vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:image": "bash test/run-image-regression.sh",
    "test:dataset": "bash test/run-dataset.sh",
    "test:live": "bash test/run-live-bench.sh live-gate.html",
    "bench:live": "bash test/run-live-bench.sh",
    "index:build": "node --max-old-space-size=4096 scripts/build-scryfall-index.mjs --all",
    "index:build:sets": "node scripts/build-scryfall-index.mjs --sets ltr,dsk",
    "index:names": "node scripts/build-name-index.mjs",
    "ocr:assets": "node scripts/setup-ocr-assets.mjs"
  },
  "dependencies": {
    "@headlessui/react": "catalog:dependencies",
    "@heroicons/react": "catalog:dependencies",
    "@tanstack/react-form": "catalog:dependencies",
    "@tanstack/react-router": "catalog:dependencies",
    "@zxcvbn-ts/core": "catalog:dependencies",
    "@zxcvbn-ts/language-common": "catalog:dependencies",
    "@zxcvbn-ts/language-de": "catalog:dependencies",
    "@zxcvbn-ts/language-en": "catalog:dependencies",
    "clsx": "catalog:dependencies",
    "components": "workspace:*",
    "motion": "catalog:dependencies",
    "react": "catalog:dependencies",
    "react-dom": "catalog:dependencies",
    "react-i18next": "catalog:dependencies",
    "react-toastify": "catalog:dependencies",
    "tesseract.js": "^5.1.1",
    "tesseract.js-core": "^5.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:devDependencies",
    "@tanstack/router-plugin": "catalog:devDependencies",
    "@types/react": "catalog:devDependencies",
    "@types/react-dom": "catalog:devDependencies",
    "@vitejs/plugin-react": "catalog:devDependencies",
    "sharp": "^0.34.5",
    "stream-json": "^1.9.1",
    "tailwindcss": "catalog:devDependencies",
    "typescript": "catalog:devDependencies",
    "vite": "catalog:devDependencies",
    "vitest": "^3.2.4"
  }
}
