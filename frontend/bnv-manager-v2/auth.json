                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/auth/jwks.json": {
            "get": {
                "summary": "The public keys tokens of this provider are signed with (RFC 7517)",
                "description": "The public keys tokens of this provider are signed with (RFC 7517)",
                "operationId": "jwks",
