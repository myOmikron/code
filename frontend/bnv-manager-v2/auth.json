    "components": {
        "schemas": {
            "ApiErrorResponse": {
                "description": "The response that is sent in a case of an error the caller should report to an admin",
                "type": "object",
                "properties": {
                    "trace_id": {
                        "description": "ID of the opentelemetry trace this error originated in",
                        "type": "string"
                    }
                },
                "required": [
                    "trace_id"
                ]
            },
            "DiscoveryResponse": {
                "description": "The OpenID provider's metadata (OpenID Connect Discovery 1.0, section 3)",
                "type": "object",
                "properties": {
                    "authorization_endpoint": {
                        "description": "Url of the authorization endpoint",
                        "type": "string",
                        "format": "uri"
                    },
                    "claims_supported": {
                        "description": "Claims the provider may supply values for",
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "code_challenge_methods_supported": {
                        "description": "Supported PKCE `code_challenge_method` values (RFC 8414 §2)",
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "grant_types_supported": {
                        "description": "Supported `grant_type` values",
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "id_token_signing_alg_values_supported": {
                        "description": "Supported signing algorithms of the ID token",
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "issuer": {
                        "description": "Identifier of the OpenID provider, the `iss` of its tokens",
                        "type": "string",
                        "format": "uri"
                    },
                    "jwks_uri": {
                        "description": "Url of the JSON Web Key Set",
                        "type": "string",
                        "format": "uri"
                    },
                    "response_modes_supported": {
                        "description": "Supported `response_mode` values",
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "response_types_supported": {
                        "description": "Supported `response_type` values",
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "scopes_supported": {
                        "description": "Supported `scope` values",
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "subject_types_supported": {
                        "description": "Supported subject identifier types",
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "token_endpoint": {
                        "description": "Url of the token endpoint",
                        "type": "string",
                        "format": "uri"
                    },
                    "token_endpoint_auth_methods_supported": {
                        "description": "Supported client authentication methods of the token endpoint",
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "userinfo_endpoint": {
                        "description": "Url of the userinfo endpoint",
                        "type": "string",
                        "format": "uri"
                    }
                },
                "required": [
                    "authorization_endpoint",
                    "claims_supported",
                    "code_challenge_methods_supported",
                    "grant_types_supported",
                    "id_token_signing_alg_values_supported",
                    "issuer",
                    "jwks_uri",
                    "response_modes_supported",
                    "response_types_supported",
                    "scopes_supported",
                    "subject_types_supported",
                    "token_endpoint",
                    "token_endpoint_auth_methods_supported",
                    "userinfo_endpoint"
                ]
            },
            "MaxStr_1024": {
                "type": "string",
                "maxLength": 1024
            },
            "MaxStr_128": {
                "type": "string",
                "maxLength": 128
            },
            "MaxStr_255": {
                "type": "string",
                "maxLength": 255
            },
            "MaxStr_72": {
                "type": "string",
                "maxLength": 72
            },
            "OidcClientUuid": {
                "description": "Client id of an OIDC client",
                "type": "string",
                "format": "uuid"
            },
            "SignInRequest": {
                "description": "Sign in request",
                "type": "object",
                "properties": {
                    "password": {
                        "description": "Password",
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/MaxStr_72"
                            }
                        ]
                    },
                    "username": {
                        "description": "Username",
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/MaxStr_255"
                            }
                        ]
                    }
                },
                "required": [
                    "password",
                    "username"
                ]
            },
            "TokenErrorCode": {
                "description": "Error codes of the token endpoint (RFC 6749 §5.2)",
                "oneOf": [
                    {
                        "description": "\"The request is missing a required parameter, includes an unsupported parameter value (other than grant type), repeats a parameter, includes multiple credentials, utilizes more than one mechanism for authenticating the client, or is otherwise malformed.\"",
                        "type": "string",
                        "enum": [
                            "invalid_request"
                        ]
                    },
                    {
                        "description": "\"Client authentication failed (e.g., unknown client, no client authentication included, or unsupported authentication method).\"",
                        "type": "string",
                        "enum": [
                            "invalid_client"
                        ]
                    },
                    {
                        "description": "\"The provided authorization grant (e.g., authorization code, resource owner credentials) or refresh token is invalid, expired, revoked, does not match the redirection URI used in the authorization request, or was issued to another client.\"",
                        "type": "string",
                        "enum": [
                            "invalid_grant"
                        ]
                    },
                    {
                        "description": "\"The authorization grant type is not supported by the authorization server.\"",
                        "type": "string",
                        "enum": [
                            "unsupported_grant_type"
                        ]
                    }
                ]
            },
            "TokenErrorResponse": {
                "description": "Error response of the token endpoint (RFC 6749 §5.2)",
                "type": "object",
                "properties": {
                    "error": {
                        "description": "Error code",
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/TokenErrorCode"
                            }
                        ]
                    },
                    "error_description": {
                        "description": "Human-readable explanation for the client developer",
                        "type": "string"
                    }
                },
                "required": [
                    "error",
                    "error_description"
                ]
            },
            "TokenRequest": {
                "description": "Form of a token request (RFC 6749 §4.1.3)\n\nA parameter may appear only once. The client authenticates either with HTTP Basic (`client_secret_basic`) or with `client_id` and `client_secret` in this form (`client_secret_post`), never with both.",
                "type": "object",
                "properties": {
                    "client_id": {
                        "nullable": true,
                        "description": "Client id, required for `client_secret_post`",
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/MaxStr_255"
                            }
                        ]
                    },
                    "client_secret": {
                        "nullable": true,
                        "description": "Secret the client authenticates with in `client_secret_post`",
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/MaxStr_255"
                            }
                        ]
                    },
                    "code": {
                        "nullable": true,
                        "description": "Code to exchange for tokens",
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/MaxStr_255"
                            }
                        ]
                    },
                    "code_verifier": {
                        "nullable": true,
                        "description": "PKCE code verifier (RFC 7636)",
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/MaxStr_128"
                            }
                        ]
                    },
                    "grant_type": {
                        "description": "Type of the grant, only `authorization_code` is supported",
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/MaxStr_255"
                            }
                        ]
                    },
                    "redirect_uri": {
                        "nullable": true,
                        "description": "Redirect uri of the authorization request",
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/MaxStr_1024"
                            }
                        ]
                    }
                },
                "required": [
                    "grant_type"
                ]
            },
            "TokenResponse": {
                "description": "Successful token response",
                "type": "object",
                "properties": {
                    "access_token": {
                        "description": "Access token for the userinfo endpoint",
                        "type": "string"
                    },
                    "expires_in": {
                        "description": "Seconds until the access token expires",
                        "type": "integer",
                        "minimum": 0,
                        "format": "uint"
                    },
                    "id_token": {
                        "description": "ID token",
                        "type": "string"
                    },
                    "token_type": {
                        "description": "Type of the access token",
                        "type": "string"
                    }
                },
                "required": [
                    "access_token",
                    "expires_in",
                    "id_token",
                    "token_type"
                ]
            },
            "UserinfoResponse": {
                "description": "Claims about the end-user",
                "type": "object",
                "properties": {
                    "email": {
                        "description": "The email",
                        "type": "string"
                    },
                    "email_verified": {
                        "description": "Whether the email is verified",
                        "type": "boolean"
                    },
                    "mailcow_template": {
