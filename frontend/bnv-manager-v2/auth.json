        "/api/v1/auth/finish-auth": {
            "get": {
                "summary": "Issue the authorization code for the pending authorization request and redirect to the client",
                "description": "Issue the authorization code for the pending authorization request and redirect to the client\n\nSends the user back to the login page when they are not signed in yet or their login is\ntoo old for the request (`login_required` with `prompt=none`), and to the error page\nwhen this session has no pending request with that id. An account that is no club\nmember, or no longer exists, gets `access_denied`.",
                "operationId": "finish_auth",
                "parameters": [
                    {
                        "in": "query",
                        "name": "request_id",
                        "schema": {
                            "description": "The pending authorization request to resume",
                            "type": "string",
                            "format": "uuid"
                        },
                        "style": "form"
                    }
                ],
                "responses": {
                    "400": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorResponse"
                                }
                            }
                        }
                    },
                    "302": {
                        "description": ""
                    }
                }
            }
        },
