        "/api/v1/auth/sign-in": {
            "post": {
                "summary": "Sign in with username (or email) and password",
                "description": "Sign in with username (or email) and password\n\nAn unknown username and a wrong password fail alike, so the response does not tell\nwhich usernames exist. On success the session gets a new id, so an id planted or seen\nbefore the login does not become a signed in session (session fixation).",
                "operationId": "sign_in",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/SignInRequest"
                            }
                        }
                    }
                },
                "responses": {
