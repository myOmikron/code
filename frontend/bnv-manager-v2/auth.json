{
    "openapi": "3.0.0",
    "info": {
        "title": "Unnamed Galvyn API",
        "version": "v0.0.0"
    },
    "paths": {
        "/api/v1/auth/auth": {
            "get": {
                "summary": "The authorization endpoint",
                "description": "The authorization endpoint\n\nStores the authorization request in the session and sends the user to the login page,\nor straight on to finishing the authorization when they are signed in already and the\nlogin is recent enough for `prompt` and `max_age`. With `prompt=none` the user never\nsees the login page, the client gets `login_required` instead.\n\nAn unknown client or `redirect_uri` sends the user to the error page and never to the\nclient. RFC 6749 §4.1.2.1: \"the authorization server SHOULD inform the resource owner\nof the error and MUST NOT automatically redirect the user-agent to the invalid\nredirection URI.\" Every other error goes back to the client.",
                "operationId": "auth",
                "parameters": [
                    {
                        "in": "query",
                        "name": "client_id",
                        "schema": {
                            "description": "Client id",
                            "allOf": [
                                {
                                    "$ref": "#/components/schemas/OidcClientUuid"
                                }
                            ]
                        },
                        "style": "form"
                    },
                    {
                        "in": "query",
                        "name": "code_challenge",
                        "schema": {
                            "nullable": true,
                            "description": "PKCE code challenge (RFC 7636)",
                            "allOf": [
                                {
                                    "$ref": "#/components/schemas/MaxStr_128"
                                }
                            ]
                        },
                        "style": "form"
                    },
                    {
                        "in": "query",
                        "name": "code_challenge_method",
                        "schema": {
                            "nullable": true,
                            "description": "PKCE code challenge method, \"S256\" or \"plain\" (the default)",
                            "allOf": [
                                {
                                    "$ref": "#/components/schemas/MaxStr_255"
                                }
                            ]
                        },
                        "style": "form"
                    },
                    {
                        "in": "query",
                        "name": "max_age",
                        "schema": {
                            "nullable": true,
                            "description": "Seconds since the last login, beyond that the login page is shown again",
                            "type": "integer",
                            "minimum": 0,
                            "format": "uint64"
                        },
                        "style": "form"
                    },
                    {
                        "in": "query",
                        "name": "nonce",
                        "schema": {
                            "nullable": true,
                            "description": "Value the ID token echoes, binding it to this request",
                            "allOf": [
                                {
                                    "$ref": "#/components/schemas/MaxStr_255"
                                }
                            ]
                        },
                        "style": "form"
                    },
                    {
                        "in": "query",
                        "name": "prompt",
                        "schema": {
                            "nullable": true,
                            "description": "Space separated: \"none\" fails instead of showing the login page, \"login\" forces the login page, \"consent\" and \"select_account\" are ignored",
                            "allOf": [
                                {
                                    "$ref": "#/components/schemas/MaxStr_255"
                                }
                            ]
                        },
                        "style": "form"
                    },
                    {
                        "in": "query",
                        "name": "redirect_uri",
                        "schema": {
                            "description": "Where to send the user with the authorization code",
                            "type": "string",
                            "format": "uri"
                        },
                        "style": "form"
                    },
                    {
                        "in": "query",
                        "name": "response_mode",
                        "schema": {
                            "nullable": true,
                            "description": "Only \"query\" is supported",
                            "allOf": [
                                {
                                    "$ref": "#/components/schemas/MaxStr_255"
                                }
                            ]
                        },
                        "style": "form"
                    },
                    {
                        "in": "query",
                        "name": "response_type",
                        "schema": {
                            "description": "Only \"code\" is supported",
                            "allOf": [
                                {
                                    "$ref": "#/components/schemas/MaxStr_255"
                                }
                            ]
                        },
                        "style": "form"
                    },
                    {
                        "in": "query",
                        "name": "scope",
                        "schema": {
                            "description": "Space separated scopes the client requests",
                            "allOf": [
                                {
                                    "$ref": "#/components/schemas/MaxStr_1024"
                                }
                            ]
                        },
                        "style": "form"
                    },
                    {
                        "in": "query",
                        "name": "state",
                        "schema": {
                            "nullable": true,
                            "description": "Opaque value returned to the client unchanged",
                            "allOf": [
                                {
                                    "$ref": "#/components/schemas/MaxStr_1024"
                                }
                            ]
                        },
                        "style": "form"
                    }
                ],
                "responses": {
                    "400": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorResponse"
                                }
                            }
                        }
                    },
                    "302": {
                        "description": ""
                    }
                }
            }
        },
