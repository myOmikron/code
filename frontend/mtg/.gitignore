# Scratch space of the openapi generator (see scripts/gen-api.sh)
tmp

# TanStack Router plugin scratch space
.tanstack/

# Generated card index (see `pnpm index:build` + `pnpm index:names`) — ~430 MB, rebuilt locally
public/data/

# Generated OCR runtime assets (see scripts/setup-ocr-assets.mjs)
public/tesseract/

# Self-signed dev TLS cert (pnpm dev:mobile)
.cert/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Output of the detection harness (see test/detect-harness.ts)
test/detect-output/

# esbuild output of the harnesses under test/ (see the scan:* and ocr:* scripts). Listed the
# other way round on purpose: every one of these has a .ts beside it and is rebuilt by the script
# that runs it, so the six without a .ts are the only ones worth keeping. A list of what to ignore
# stopped covering the harnesses added after it was written, which is how four bundles ended up
# staged for a commit.
test/*.mjs
!test/cdp-run.mjs
!test/collect-failures.mjs
!test/dataset-scan.mjs
!test/detect-sheet.mjs
!test/overlay-debug.mjs
!test/printing-regression.mjs
scripts/build-embedding-index.mjs

# Photographs the scanner got wrong, cut into per-step renders (see test/failure-steps.ts).
# Regenerated from the labelled corpus, tens of megabytes, and stale the moment the pipeline moves.
test/fehlschlaege/

# Generated model runtime (see README in scripts/)
public/models/
public/ort/
